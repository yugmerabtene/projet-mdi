# ===========================================================================
# .env.example — modèle de configuration du laboratoire Moodle
# ---------------------------------------------------------------------------
# RÔLE DU FICHIER
# Ce fichier est le MODÈLE du fichier .env, celui que l'étudiant va remplir.
# Il ne contient AUCUNE valeur : uniquement les noms de variables attendus et
# la marche à suivre.
#
# POURQUOI AUCUN MOT DE PASSE ICI
# Un dépôt Git conserve son historique. Même après suppression, une valeur
# reste lisible dans l'historique, et un dépôt peut être cloné, archivé, ou
# transmis. Or :
#
#   - .env est dans .gitignore : il n'est JAMAIS enregistré ;
#   - .env.example est, lui, enregistré, parce qu'il ne contient aucun secret.
#
# C'est la règle générale : on versionne la FORME d'un secret, jamais le secret.
# Un gabarit vide vaut mieux qu'une valeur factice dans un dépôt, car une
# valeur factice finit toujours par être réutilisée telle quelle.
#
# MODE D'EMPLOI
#   1. cp .env.example .env
#   2. nano .env        (ou tout éditeur)
#   3. compléter les trois lignes marquées « À COMPLÉTER »
#   4. docker compose up --build
#
# CHOIX DES VALEURS
# Ces valeurs ne quittent JAMAIS la machine du laboratoire : le réseau du
# laboratoire est déclaré « interne », donc la pile n'a aucun accès à Internet,
# et la base de données n'est publiée sur aucun port de la machine. Un mot de
# passe inventé pour l'occasion est donc suffisant. N'utilisez jamais un mot de
# passe réel : cette plateforme de laboratoire n'est pas un système de
# production, et s'y fier serait une erreur.
# ===========================================================================

# -----------------------------------------------------------------------------
# Adresse et identité du site
# -----------------------------------------------------------------------------

# Adresse publique du site. Elle doit correspondre EXACTEMENT à ce que le
# navigateur saisit, port compris. Une valeur fausse produit un site qui
# fonctionne mais dont tous les liens pointent ailleurs.
#
# À COMPLÉTER si le port publié change dans compose.yaml.
MOODLE_WWWROOT=http://localhost:8081

# Nom affiché de la plateforme et nom court utilisé dans les liens et les
# courriels. Le nom court doit commencer par une lettre et ne contenir ni
# espace, ni accent, ni caractère spécial.
MOODLE_FULLNAME=Plateforme du laboratoire
MOODLE_SHORTNAME=labo

# Langue de l'interface. Moodle accepte « fr » pour le français.
MOODLE_LANG=fr

# Texte de présentation affiché sur la page d'accueil après installation.
MOODLE_SUMMARY=Plateforme pédagogique du laboratoire de conteneurisation.

# -----------------------------------------------------------------------------
# Compte d'administration
# -----------------------------------------------------------------------------
# Ces trois valeurs ne servent qu'au premier démarrage, quand Moodle crée la
# table des comptes. Ensuite, le changement de mot de passe passe par
# l'interface du site, et ces variables n'ont plus aucun effet. D'où l'intérêt
# de ne pas y mettre une valeur réelle : même oubliée, elle ne sert plus.

# Identifiant du compte d'administration.
MOODLE_ADMIN_USER=admin

# Mot de passe du compte d'administration.
# ATTENTION : les règles de robustesse de Moodle sont actives dès
# l'installation. Un mot de passe trop court ou trop simple est refusé.
# À COMPLÉTER — inventer une valeur de laboratoire, par exemple un mot de
# passe long composé de plusieurs mots.
MOODLE_ADMIN_PASSWORD=

# Adresse électronique du compte d'administration. Moodle n'envoie aucun
# courriel en laboratoire ; la valeur sert à remplir le compte.
# À COMPLÉTER — une adresse de laboratoire, par exemple admin@labo.local
MOODLE_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Base de données
# -----------------------------------------------------------------------------
# Nom de la base et identifiant de l'application. Ces valeurs sont libres.
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle

# Mot de passe du compte applicatif.
# À COMPLÉTER — inventer une valeur de laboratoire. La même valeur doit être
# fournie au conteneur « bd » ET au conteneur « moodle » : c'est le même
# compte, vu des deux côtés.
MOODLE_DB_PASSWORD=

# Mot de passe du compte « root » de MariaDB, réservé à l'administration de la
# base. Il n'est utilisé par aucun service du laboratoire ; il existe parce que
# l'image MariaDB l'exige.
# À COMPLÉTER — une autre valeur de laboratoire, différente de la précédente.
# Deux mots de passe distincts, c'est du cloisonnement : si un compte
# applicatif est compromis, l'administration de la base reste protégée.
MOODLE_DB_ROOT_PASSWORD=
